# Token do bot
# Discord Developer Portal → seu app → Bot → Token
DISCORD_TOKEN=seu_token_aqui

# ID do servidor (guild)
# Discord: Configurações → Avançado → Modo desenvolvedor ON
# Clica com botão direito no servidor → Copiar ID
DISCORD_GUILD_ID=id_do_servidor

# Seu Discord ID (para comandos admin)
# Clica com botão direito no seu perfil → Copiar ID
DISCORD_ADMIN_ID=seu_discord_id

# Canal onde o bot posta o resultado quando o jogo terminar
# Clica com botão direito no canal → Copiar ID
DISCORD_RESULTS_CHANNEL_ID=id_do_canal

# football-data.org (cadastro grátis em football-data.org)
FOOTBALL_API_KEY=sua_api_key
FOOTBALL_COMPETITION=2000

# Banco
DB_PATH=./bolao.db
